# Copy to .env and fill in. Never commit .env. ShipSafe only talks to the PayPal sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Shown on the sandbox app's page once a webhook is added. Webhooks are refused until it is set.
PAYPAL_WEBHOOK_ID=
# Without this key the AI review can't run, so every order is held for the seller.
ANTHROPIC_API_KEY=
# Optional: the model for the AI review. Defaults to claude-opus-5-5.
# SHIPSAFE_MODEL=claude-opus-5-5
# Optional: AI reviews allowed per 24 hours. Past it, orders are held without calling Claude.
# SHIPSAFE_DAILY_REVIEWS=3
